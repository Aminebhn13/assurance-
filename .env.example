# ===== AssureCrypto — Variables d'environnement =====
# Copie ce fichier en .env.local et remplis les valeurs (jamais commité).

# Provider RPC Ethereum (public par défaut, remplace par ta clé Infura/Alchemy)
NEXT_PUBLIC_RPC_URL=https://eth.llamarpc.com

# Adresses des stablecoins sur Ethereum Mainnet (lecture seule)
NEXT_PUBLIC_USDC_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
NEXT_PUBLIC_USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7

# WalletConnect Project ID (optionnel — requis pour la connexion WalletConnect)
# Crée un projet sur https://cloud.reown.com puis colle ton Project ID ici.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Wallet de réception des primes (USDC, Ethereum mainnet)
NEXT_PUBLIC_PREMIUM_RECEIVER=0xaB570A549986A0Cd2F66f563D0D0d98C73A9855E
